# Third-party benchmark data are downloaded from the official source.
# Keep the download instructions in data/README.md, but do not redistribute
# the original BSDS500 images and human annotations in this repository.
/data/BSR/BSDS500/data/
/data/BSR/bench/data/
/data/BSR/documentation/

# Regenerable experiment and presentation artifacts; keep summary tables and
# source scripts, while publishing the reproducibility instructions instead
# of thousands of per-image intermediates.
/results/fscod_artifacts/
/results/*_per_image.csv
/figures/*.tiff
/logs/
